# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/

# 日志与临时文件
logs/
*.log
*.tmp
tmp/
.vscode/
.idea/

# 但联机验证的原始输出是报告引用的证据（已确认不含路径与用户名），单独放行
!docs/reports/lan_demo/*.log
!docs/reports/lan_demo_lanip/*.log

# 用户本地设置（每台机器不同，不提交）
config/user_settings.json
settings.local.json

# 存档属于本机运行产物
saves/*.json
!saves/.gitkeep
autosave*

# 联机诊断包（v0.4 起可从诊断页导出，含本机网络信息，绝不入库）
diag/

# 自动生成的校验截图（报告里的关键几张单独保留，其余忽略）
docs/reports/shots/06b_wait_roll_*.png
docs/reports/shots/06c_modal_*.png

# 打包产物
build/
dist/
*.spec

# 临时补丁脚本（一次性工具，不入库）
tools/_patch_*.py

# 日志与临时输出
logs/*
!logs/README.txt
